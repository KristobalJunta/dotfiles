{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  "
  },
  "logo": {
    "type": "small",
    "padding": {
      "top": 1
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#45D6AD",
        "at": "#FCDD3F",
        "host": "#00AF8F"
      }
    },
    "break",
    {
      "type": "os"
    },
    {
      "type": "kernel"
    },
    {
      "type": "memory",
      "key": "RAM",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "DSK"
    },
    {
      "type": "battery",
      "key": "BAT"
    },
    {
      "type": "shell"
    },
    {
      "type": "uptime",
      "key": "UP"
    }
  ]
}
